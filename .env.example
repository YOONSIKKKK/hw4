# Copy this file to `.env` in this same folder and fill in real values.
# The real .env is gitignored and must never be committed.

# Gateway key used for every model call the agent makes.
PORTKEY_API_KEY=your_portkey_api_key_here

# Signing key for the session cookie. Any long random string.
# If unset, the server generates one at startup — fine locally, but sessions
# then end whenever the server restarts.
SESSION_SECRET=replace_with_a_long_random_string

# For reference only — not read from the environment. The model id and gateway
# URL are set in backend/agent.py:
#   MODEL_NAME = "claude-opus-5"
#   PORTKEY_BASE_URL = "https://api.portkey.ai/v1"
